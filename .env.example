NODE_ENV=development
PORT=8080
CLIENT_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

SESSION_COOKIE_NAME=autobattle_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false

PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_JWT_VERIFICATION_KEY=your-privy-verification-key

# Solana & Web3
SOLANA_RPC_URL=https://api.devnet.solana.com
CRANK_PRIVATE_KEY=[1,2,3,...] # JSON array of crank wallet secret key bytes
AUTO_TOKEN_ADDRESS=                # $AUTO SPL token mint address
SWITCHBOARD_PROGRAM_ID=Aio4gaXjXzJNVLtzwtNVmSqGKpANtXhybbkhtAC94ji2

# Agent Wallets (separate keypairs for Red/Blue agent on-chain signing)
AGENT_RED_PRIVATE_KEY=[1,2,3,...]  # JSON array of Red agent secret key bytes
AGENT_BLUE_PRIVATE_KEY=[1,2,3,...] # JSON array of Blue agent secret key bytes

# LLM API (sensitive — used for AI agent decisions)
LLM_API_ENDPOINT=https://your-llm-api-endpoint.com/api/run

# Crank Engine
CRANK_INTERVAL_MS=10000
CRANK_ENABLED=false

# Match Break (seconds between matches, default 300 = 5 minutes)
MATCH_BREAK_SECONDS=300

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_IDS=123456789,987654321

# Admin API Key (secures pause/resume endpoints)
ADMIN_API_KEY=your-admin-api-key