generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id
  username         String    @unique
  walletAddress    String?
  email            String?
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  totalPredictions Int       @default(0)
  totalEarnings    Decimal   @default(0) @db.Decimal(20, 8)
  totalWins        Int       @default(0)

  predictions  Prediction[]
  comments     Comment[]
  commentLikes CommentLike[]

  @@index([username])
}

model Match {
  id        String @id @default(cuid())
  gameId    Int    @unique // The on-chain global game ID
  gamePda   String @unique // The GameState PDA
  matchUuid String @unique // UUID for LLM chat context (chatId)
  agentRed  String // Pubkey of the Red Agent
  agentBlue String // Pubkey of the Blue Agent
  llmRed    String // OpenRouter model name for Red agent
  llmBlue   String // OpenRouter model name for Blue agent
  redName   String @default("Red")
  blueName  String @default("Blue")

  status      MatchStatus @default(MATCHMAKING)
  roundNumber Int         @default(1)
  redHp       Int         @default(10)
  blueHp      Int         @default(10)
  winner      String? // "RED" or "BLUE" — set on resolution

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markets Market[] // One-to-many relationship for micro-markets
  rounds  MatchRound[] // Per-round logs

  @@index([gameId])
}

// ── Round & Move Logging ──────────────────────────────────────────

model MatchRound {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  roundNumber    Int
  phase          String // Final phase after resolution (e.g. "ENDED", "AWAITING_INITIAL_DEAL")
  redScoreInit   Int // Red score after initial deal
  blueScoreInit  Int // Blue score after initial deal
  redScoreFinal  Int // Red score after river
  blueScoreFinal Int // Blue score after river
  redHpBefore    Int
  blueHpBefore   Int
  redHpAfter     Int
  blueHpAfter    Int
  damageDealt    Int
  roundWinner    String? // "RED", "BLUE", or null (tiebreaker ongoing)

  // Card tracking — stored as JSON arrays: [{ value: 10, label: "K" }, ...]
  redCardsDealt   Json  @default("[]")
  blueCardsDealt  Json  @default("[]")
  riverRedCard    Json? // Single card object
  riverBlueCard   Json? // Single card object
  tiebreakerCards Json  @default("[]") // Array of tiebreaker card pairs

  roundSystemLogs Json @default("[]") // System logs for the given round

  createdAt DateTime @default(now())

  moves RoundMove[]

  @@unique([matchId, roundNumber])
  @@index([matchId])
}

model RoundMove {
  id      String     @id @default(cuid())
  roundId String
  round   MatchRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  moveNumber  Int // Order of move within the round (1, 2, 3...)
  player      String // "RED" or "BLUE"
  action      String // "HIT", "STAY", "FORCED_STAY"
  reason      String? // LLM's reasoning for the decision
  model       String // OpenRouter model identifier used
  scoreBefore Int // Score before this move
  scoreAfter  Int // Score after this move (same for STAY)
  cardDealt   Json? // The card dealt on HIT: { value: 10, label: "K" }
  txSignature String? // On-chain transaction signature

  createdAt DateTime @default(now())

  @@index([roundId])
}

model Market {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?

  // SOLANA INTEGRATION FIELDS
  matchId     String
  match       Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  marketPda   String @unique
  vaultPda    String @unique
  marketIndex Int    @default(0) // 0 for MAIN, 1+ for mid-game markets

  // MICRO-MARKET TRACKING
  marketType       MarketType       @default(MAIN)
  resolutionMethod ResolutionMethod @default(ON_CHAIN)
  targetRound      Int? // Populated if MarketType is MID_GAME

  status         MarketStatus    @default(OPEN)
  closesAt       DateTime
  resolvesAt     DateTime?
  winningOutcome PredictionSide?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions Prediction[]
  comments    Comment[]

  @@index([matchId])
}

model Prediction {
  id          String         @id @default(cuid())
  userId      String
  marketId    String
  side        PredictionSide // YES = Red, NO = Blue
  amount      Decimal        @db.Decimal(20, 8)
  shareAmount Decimal        @default(0) @db.Decimal(20, 8)

  positionPda String
  hasClaimed  Boolean @default(false)

  createdAt DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can only have ONE 'YES' row and ONE 'NO' row per market
  @@unique([userId, marketId, side], name: "userMarketSide")
  @@index([marketId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  comment   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  market       Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentLikes CommentLike[]

  @@index([marketId])
  @@index([userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([userId])
}

// ── Enums ─────────────────────────────────────────────────────────

enum MarketStatus {
  OPEN
  RESOLVED
  CANCELED
}

enum MatchStatus {
  MATCHMAKING // Market is OPEN, waiting for initial deal (5-min matchmaking phase)
  ACTIVE // Match is fighting / dealing cards
  PAUSED // Halted due to critical transaction failure — awaiting dev intervention
  RESOLVED // HP hit 0, Game over
  PENDING // Deprecated: use MATCHMAKING
}

enum PredictionSide {
  YES // Betting on Red (or 'Yes' for mid-game props)
  NO // Betting on Blue (or 'No' for mid-game props)
}

enum MarketType {
  MAIN // The overall "Who will win the match?" market
  MID_GAME // Per-round micro-bets (e.g., "Will Red bust this round?")
}

enum ResolutionMethod {
  ON_CHAIN // Resolved strictly by smart contract math (HP = 0)
  AI_AGENT // Resolved by AI agent interpreting round results
}

model Celebrity {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String
  prompt    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
